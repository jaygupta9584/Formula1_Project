{
  "datasets": [
    {
      "name": "top_circuits",
      "displayName": "Top Circuits",
      "queryLines": [
        "SELECT\n",
        "  circuit_name,\n",
        "  total_races,\n",
        "  total_points\n",
        "FROM\n",
        "  f1_catalog.gold.circuit_performance\n",
        "ORDER BY\n",
        "  total_races DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "top_constructors",
      "displayName": "Top Constructors",
      "queryLines": [
        "SELECT\n",
        "  constructor_name,\n",
        "  race_wins,\n",
        "  podiums,\n",
        "  total_points,\n",
        "  races,\n",
        "  ROUND((race_wins / races) * 100, 2) AS win_pct\n",
        "FROM\n",
        "  f1_catalog.gold.constructor_performance\n",
        "ORDER BY\n",
        "  race_wins DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "top_drivers",
      "displayName": "Top Drivers",
      "queryLines": [
        "SELECT\n",
        "  driver_name,\n",
        "  race_wins,\n",
        "  podiums,\n",
        "  total_points,\n",
        "  races,\n",
        "  ROUND((race_wins / races) * 100, 2) AS win_pct\n",
        "FROM\n",
        "  f1_catalog.gold.driver_performance\n",
        "ORDER BY\n",
        "  race_wins DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "season_trends",
      "displayName": "Season Trends",
      "queryLines": [
        "SELECT\n",
        "  season,\n",
        "  total_races,\n",
        "  total_drivers,\n",
        "  total_constructors,\n",
        "  total_points\n",
        "FROM\n",
        "  f1_catalog.gold.season_summary\n",
        "ORDER BY\n",
        "  season"
      ]
    },
    {
      "name": "dq_summary",
      "displayName": "Data Quality Summary",
      "queryLines": [
        "SELECT\n",
        "  check_status,\n",
        "  COUNT(*) AS check_count\n",
        "FROM\n",
        "  f1_catalog.gold.data_quality_audit\n",
        "GROUP BY\n",
        "  check_status"
      ]
    },
    {
      "name": "pipeline_overview",
      "displayName": "Pipeline Overview",
      "queryLines": [
        "SELECT\n",
        "  layer,\n",
        "  table_name,\n",
        "  row_count,\n",
        "  last_updated\n",
        "FROM\n",
        "  f1_catalog.gold.pipeline_metadata\n",
        "ORDER BY\n",
        "  layer,\n",
        "  table_name"
      ]
    },
    {
      "name": "f1_drivers",
      "displayName": "F1 Top Drivers",
      "queryLines": [
        "SELECT\n",
        "  driver_name,\n",
        "  race_wins,\n",
        "  podiums,\n",
        "  total_points,\n",
        "  races,\n",
        "  ROUND((race_wins / races) * 100, 2) AS win_pct\n",
        "FROM\n",
        "  f1_catalog.gold.driver_performance\n",
        "ORDER BY\n",
        "  race_wins DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "test_ds",
      "displayName": "Test Dataset",
      "queryLines": [
        "SELECT\n",
        "  1 AS val"
      ]
    }
  ],
